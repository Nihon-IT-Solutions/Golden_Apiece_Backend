# Copy this file to .env and fill in your Supabase details.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> "Session pooler" (port 5432)
# Replace [YOUR-PASSWORD] with your database password. Keep the "postgresql+psycopg://" prefix.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default admin created on first start (change the passwords after first login)
ADMIN_USERNAME=GOLDADMIN
ADMIN_PASSWORD=Admin@123
ADMIN_TXN_PASSWORD=12345678
# true = also create demo members, commissions and payouts so the dashboards are not empty
SEED_DEMO_DATA=true
